# syntax=docker/dockerfile:1
# ===========================================================================
# MatterChat — from-SOURCE multi-stage build for the Alpha preview environment.
# ===========================================================================
# Rocket.Chat's own .docker/Dockerfile.debian is RUNTIME-ONLY: it copies an
# already-built Meteor bundle (`/app/bundle`) and cannot build the cloned source.
# The Alpha orchestrator builds from the cloned repo, so this Dockerfile runs the
# full `meteor build` (stage 1) then mirrors Dockerfile.debian's runtime (stage 2).
#
# NOTE FOR OPS: the `meteor build` stage is heavy (~10-20 min) and memory-hungry
# (give the builder >= 4-6 GB; NODE_OPTIONS bumps the heap). This is a best-effort
# draft and likely needs a round of on-box iteration. It mirrors the repo's
# `yarn build:ci` (= meteor build --server-only) for the builder and the runtime
# steps from .docker/Dockerfile.debian for the final image.

ARG DENO_VERSION="1.37.1"
ARG DENO_BUILD_VERSION="2.3.1"
ARG METEOR_RELEASE="3.4.1"
ARG NODE_VERSION="22.22.3"

# Two Deno versions: the Apps-Engine RUNTIME bakes 1.37.1, but @rocket.chat/apps'
# build:deno-cache script (build time) requires 2.3.1. Define both first so each
# stage copies the one it needs.
FROM denoland/deno:bin-${DENO_VERSION} AS deno
FROM denoland/deno:bin-${DENO_BUILD_VERSION} AS deno_build

# ---- Stage 1: build the Meteor server bundle from source ------------------
FROM node:${NODE_VERSION}-bullseye AS builder
ARG METEOR_RELEASE
ARG NPM_TOKEN
# Promote NPM_TOKEN to an env var so Yarn 4 picks it up: .yarnrc.yml routes the
# @omnisaiorg scope (e.g. @omnisaiorg/litbox-file-browser) to npm.pkg.github.com
# with npmAuthToken "${NPM_TOKEN-}". Yarn 4 reads .yarnrc.yml (NOT .npmrc), so the
# old .npmrc line below was both wrong-registry and ignored.
ENV NPM_TOKEN=${NPM_TOKEN} \
    METEOR_ALLOW_SUPERUSER=true \
    CI=true \
    NODE_OPTIONS=--max-old-space-size=6144
RUN apt-get update && apt-get install -y --no-install-recommends \
      curl python3 g++ make git ca-certificates && rm -rf /var/lib/apt/lists/*
# Meteor toolchain, pinned to the app's release.
RUN curl -fsSL "https://install.meteor.com/?release=${METEOR_RELEASE}" | sh
ENV PATH="/root/.meteor:${PATH}"
RUN corepack enable
# @rocket.chat/apps' build:deno-cache (run during `yarn build` below) needs deno
# 2.3.1 on PATH; without it the package prebuild fails and meteor build then can't
# find packages/livechat/dist (and others).
COPY --from=deno_build /deno /usr/local/bin/deno
WORKDIR /src
COPY . .
# @omnisaiorg GitHub Packages auth is handled by .yarnrc.yml + the NPM_TOKEN env
# var promoted above (Yarn 4). No .npmrc needed.
# Install workspace deps, pre-build the packages Meteor links (turbo), then build the server-only
# bundle (mirrors `yarn build:ci`).
#
# THE PREBUILD IS NOT "BEST-EFFORT" — that old comment was wrong, and the `|| true` it justified
# cost a full debugging round on 2026-08-06. `meteor build` does NOT regenerate the i18n typed keys;
# packages/rocketchat-i18n/i18n is produced HERE and nowhere else. So a swallowed prebuild failure
# does not degrade gracefully, it resurfaces two steps later as
#     Error: ENOENT: no such file or directory, scandir '.../packages/rocketchat-i18n/i18n'
# which names neither the failing package nor the real cause. The actual failure that night was a
# ts-patch/typia race truncating node_modules/typescript/lib/_tsc.js, after which
# @rocket.chat/base64 died with "SyntaxError: Unexpected end of input" — three removes from the
# error the log actually reported.
#
# Retry once, because that corruption is transient on a cold turbo cache and a re-run clears it.
# Then fail loudly rather than silently.
RUN yarn install --immutable || yarn install
RUN yarn build --filter=@rocket.chat/meteor^... \
 || (echo ">>> prebuild failed — retrying once (ts-patch/typia can corrupt node_modules/typescript on a cold cache)" \
     && yarn build --filter=@rocket.chat/meteor^...)
# Belt and braces: a PARTIALLY successful prebuild must not pass silently either. Assert the one
# artifact meteor cannot produce for itself, and say so in terms someone can act on.
RUN test -d /src/apps/meteor/packages/rocketchat-i18n/i18n \
 || (echo ">>> FATAL: packages/rocketchat-i18n/i18n is missing after the prebuild." \
     && echo ">>> meteor build would now fail with a misleading ENOENT. Fix the turbo prebuild above." \
     && false)
WORKDIR /src/apps/meteor
RUN METEOR_DISABLE_OPTIMISTIC_CACHING=1 meteor build --server-only --directory /build

# ---- Stage 2: runtime (mirrors .docker/Dockerfile.debian) -----------------
FROM node:${NODE_VERSION}-bullseye-slim
LABEL maintainer="omnisai (MatterChat alpha)"
RUN groupadd -g 65533 -r rocketchat \
    && useradd -u 65533 -r -g rocketchat rocketchat \
    && mkdir -p /app/uploads \
    && chown rocketchat:rocketchat /app/uploads \
    && apt-get update \
    && apt-get install -y --no-install-recommends fontconfig curl \
    && rm -rf /var/lib/apt/lists/*
COPY --from=deno /deno /bin/deno
COPY --from=builder --chown=rocketchat:rocketchat /build/bundle /app/bundle
# Defaults; the alpha compose template overrides MONGO_URL/MONGO_OPLOG_URL/ROOT_URL.
ENV DEPLOY_METHOD=docker \
    NODE_ENV=production \
    MONGO_URL=mongodb://mongo:27017/matterchat \
    HOME=/tmp \
    PORT=3000 \
    ROOT_URL=http://localhost:3000 \
    Accounts_AvatarStorePath=/app/uploads
# Install the bundle's server deps (mirrors Dockerfile.debian), then drop the
# build toolchain to keep the runtime image lean.
RUN aptMark="$(apt-mark showmanual)" \
    && apt-get update \
    && apt-get install -y --no-install-recommends g++ make python3 ca-certificates \
    && cd /app/bundle/programs/server \
    && npm install --omit=dev \
    && cd npm/node_modules/isolated-vm \
    && npm install --omit=dev \
    && npm cache clear --force \
    && find /app/bundle/programs/server/npm/node_modules -type f -name '*.map' -delete \
    && find /app/bundle/programs/web.browser -type f -name '*.map' -delete \
    && apt-get purge -y --auto-remove g++ make \
    && rm -rf /var/lib/apt/lists/*
USER rocketchat
VOLUME /app/uploads
WORKDIR /app/bundle
EXPOSE 3000
CMD ["node", "main.js"]
