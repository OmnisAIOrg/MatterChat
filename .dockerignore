# Keep the `COPY . .` build context lean for the heavy Meteor build.
# (The Dockerfile.alpha builder runs `yarn install` itself, so we do NOT
#  ship host node_modules / Meteor local caches into the image.)

# Dependencies (re-installed inside the build)
node_modules
**/node_modules

# Meteor build caches (huge; regenerated by `meteor build`)
.meteor/local
apps/meteor/.meteor/local
**/.meteor/local

# Logs + scratch. NOTE: do NOT exclude .git — the Rocket.Chat meteor build runs
# `git log` to embed version/commit info and fails ("Command failed: git log")
# without it. The CI checkout is shallow so .git stays small.
.gitignore
*.log
**/*.log

# Frontend build artifacts / caches
.vite
**/.vite
dist
**/dist

# Temp
/tmp
**/tmp

# Local secrets must never enter the build context
.npmrc
**/.npmrc
.env
.env.*
**/.env
**/.env.*
